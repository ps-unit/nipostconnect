# ── DATABASE ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/nipost_connect"

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET="nipost_connect_jwt_secret_change_in_production_min_64_chars"
JWT_REFRESH_SECRET="nipost_connect_refresh_secret_change_in_production_too"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── SERVER ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
SERVER_URL="http://localhost:5000"

# ── DOMAIN RESTRICTION ───────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN="nglosa.com"

# ── VAPID (Phase 2 — Web Push Notifications) ─────────────────────────────
# Generate with: cd server && npm run vapid:generate
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:ict@nglosa.com

# ── FILE UPLOADS (Phase 2) ────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10

# ── SUPER ADMIN SEED ─────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="pmg@nglosa.com"
SEED_ADMIN_PASSWORD="NiPOST@Admin2026"
SEED_ADMIN_NAME="Postmaster General"
SEED_ADMIN_STAFF_ID="NPS/HQ/2024/001"
