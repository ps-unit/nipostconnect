# NiPOST Connect — Production Environment Variables
# Copy to server/.env and fill in all values before deploying

# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://nipost_user:STRONG_PASSWORD_HERE@localhost:5432/nipost_connect"

# ── JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="GENERATE_64_RANDOM_BYTES_AND_PASTE_HERE"
JWT_REFRESH_SECRET="GENERATE_ANOTHER_64_RANDOM_BYTES_HERE"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
CLIENT_URL="https://connect.nglosa.com"
SERVER_URL="https://connect.nglosa.com"
ALLOWED_EMAIL_DOMAIN="nglosa.com"

# ── EMAIL (Brevo / Sendgrid / any SMTP) ──────────────────────────────────────
# Brevo: smtp.brevo.com, port 587
# Sendgrid: smtp.sendgrid.net, port 587
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM_NAME=NiPOST Connect
EMAIL_FROM_ADDR=noreply@nglosa.com

# ── PUSH NOTIFICATIONS (generate with: cd server && npm run vapid:generate)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:ict@nglosa.com

# ── TERMII SMS ────────────────────────────────────────────────────────────────
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=NiPOST
TERMII_BASE_URL=https://api.ng.termii.com/api

# ── ANTHROPIC AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── TWO-FACTOR AUTH ───────────────────────────────────────────────────────────
TWO_FA_ISSUER=NiPOST Connect
TWO_FA_ENFORCE_ROLES=SUPER_ADMIN,STATE_ADMIN

# ── ERROR MONITORING (optional but recommended) ───────────────────────────────
# Create free account at https://sentry.io
SENTRY_DSN=https://your_key@sentry.io/your_project_id

# ── SEED (change after first run) ────────────────────────────────────────────
SEED_ADMIN_EMAIL="pmg@nglosa.com"
SEED_ADMIN_PASSWORD="CHANGE_THIS_ON_FIRST_LOGIN"
SEED_ADMIN_NAME="Postmaster General"
SEED_ADMIN_STAFF_ID="NPS/HQ/2024/001"
